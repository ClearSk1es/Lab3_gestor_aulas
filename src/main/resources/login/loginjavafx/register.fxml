<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER"
      prefHeight="520.0"
      prefWidth="650.0"
      style="-fx-background-color: #f1f5f9;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="login.sistema.gestion.aulas.RegisterController">
    <children>
        <VBox alignment="CENTER"
      spacing="12.0"
      maxWidth="420.0"
      style="-fx-background-color: white;
             -fx-background-radius: 12;
             -fx-border-color: #dbe3ec;
             -fx-border-radius: 12;">

    <padding>
        <Insets top="28.0" right="35.0"
                bottom="28.0" left="35.0"/>
    </padding>

    <children>

        <Label text="Registrar usuarios"
               style="-fx-font-size: 23px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1e293b;"/>

        <Label text="Complete los datos del nuevo usuario"
               style="-fx-font-size: 12px;
                     -fx-text-fill: #64748b;"/>
        
        <VBox spacing="5.0">
            <Label text="Nombre:"/>
            <TextField fx:id="txtNombre"
                        promptText="Ingrese el nombre"
                        maxWidth="Infinity"/>
        </VBox>
        
        <VBox spacing="5.0">
            <Label text="Apellido:"/>
            <TextField fx:id="txtApellido"
                       promptText="Ingrese el apellido"
                       maxWidth="Infinity"/>
        </VBox>
        
        
        <VBox spacing="5.0">
            <Label text="Usuario:"/>
            <TextField fx:id="txtUsuario"
                       promptText="Ingrese el nombre de usuario"
                       maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Clave:"/>
            <PasswordField fx:id="txtClave"
                           promptText="Ingrese la contraseña"
                           maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Correo electrónico:"/>
            <TextField fx:id="txtCorreo"
                       promptText="ejemplo@correo.com"
                       maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Rol:"/>
            <ComboBox fx:id="cbRol"
                      promptText="Seleccione un rol"
                      maxWidth="Infinity">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Administrador"/>
                        <String fx:value="Docente"/>
                        <String fx:value="Estudiante"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>

        
        <Label fx:id="lblMensaje"
               wrapText="true"
               maxWidth="Infinity"
               style="-fx-text-fill: #dc2626;"/>

        <Button fx:id="btnRegistrar"
                text="REGISTRAR USUARIO"
                onAction="#registrarUsuario"
                maxWidth="Infinity"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 11 15;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>

            </children>
        </VBox>
    </children>
</HBox>
